# ============================================================
# Sankofa Library System — environment variables (FLASK-ADAPT)
# Copy this file to `.env` and adjust for your deployment.
# ============================================================

# ---- App / secrets ----
# REQUIRED in production. Use a strong random value (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
SECRET_KEY=dev-secret-key-change-in-production

# ---- Database ----
# SQLite (default, great for local dev):
DATABASE_URL=sqlite:///sankofa_library.db
# MySQL (production):
# DATABASE_URL=mysql+pymysql://user:password@localhost/sankofa_library

# ---- Session security ----
# Set to `true` when serving the app over HTTPS in production.
SESSION_COOKIE_SECURE=false

# ---- Mail server (outbound email) ----
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@sankofa-library.edu
# Set to `false` to actually deliver email; `true` suppresses sends (dev default).
MAIL_SUPPRESS_SEND=true

# ---- Library policy defaults ----
# Used the first time the app boots to seed the SystemSetting table.
STUDENT_EMAIL_DOMAIN=st.knust.edu.gh
CURRENCY_SYMBOL=GHS

# ---- Rate limiting (Flask-Limiter) ----
# Optional: a Redis URI enables shared rate-limit state across workers.
# RATELIMIT_STORAGE_URI=redis://localhost:6379
